{
  "server": {
    "base_url": "https://127.0.0.1:55601",
    "config_db_path": "../../var/otomekairo/config.db",
    "tls_verify": false,
    "request_timeout_seconds": 10
  },
  "connector": {
    "client_id": "pico-environment-main",
    "sensor_source_id": "sensor_source:pico_environment",
    "serial_port": "/dev/serial/by-id/REPLACE_WITH_PICO_DEVICE",
    "poll_interval_seconds": 10,
    "serial_timeout_seconds": 10
  },
  "change_detection": {
    "max_gap_seconds": 30,
    "channels": {
      "temperature": {"steady_delta": 0.1, "rapid_delta": 0.5},
      "humidity": {"steady_delta": 1, "rapid_delta": 5},
      "illuminance": {"steady_delta": 10, "rapid_delta": 100},
      "co2": {"steady_delta": 30, "rapid_delta": 300}
    }
  },
  "temperature_wake": {
    "enabled": true,
    "min_interval_seconds": 120,
    "request_timeout_seconds": 120
  }
}
